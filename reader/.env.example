# Copia este archivo como ".env" en la misma carpeta y ajusta los valores. NO lo subas a git.

# Tu base de datos PostgreSQL (misma PC: localhost). Cambia usuario, clave y nombre de la BD.
DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/nombre_de_tu_bd

# (Siguiente paso: aviso a Telegram) Token del bot, lo da @BotFather.
TELEGRAM_BOT_TOKEN=
